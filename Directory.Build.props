<Project>
  <PropertyGroup>
    <!-- All editor, QA and benchmark projects target Windows x64. A RID keeps
         transitive ONNX assets for other platforms out of development output.
         Publish.ps1 explicitly overrides SelfContained for portable releases. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <!-- Stable virtual source paths prevent local account and checkout names
         from being embedded in application symbols and stack traces. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <!-- CAD/text bitmap imports must finish even if an RDP session disconnects. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.ShouldRenderEvenWhenNoDisplayDevicesAreAvailable" Value="true" />
  </ItemGroup>
</Project>
